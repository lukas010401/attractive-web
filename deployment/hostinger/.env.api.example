ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Host=attractive-db;Port=5432;Database=attractive_catalog;Username=attractive_user;Password=CHANGE_THIS_POSTGRES_PASSWORD
Frontend__AllowedOrigins__0=https://attractive-store.com
Frontend__AllowedOrigins__1=https://www.attractive-store.com
Jwt__Issuer=AttractiveCatalog.Api
Jwt__Audience=AttractiveCatalog.Frontend
Jwt__Key=CHANGE_THIS_SUPER_SECRET_KEY_AT_LEAST_32_CHARS
Jwt__ExpiryMinutes=60
Jwt__RefreshTokenDays=15
AdminSeed__Email=admin@attractive-store.com
AdminSeed__Password=CHANGE_THIS_ADMIN_PASSWORD
Media__MaxImagesPerProduct=10
Media__MaxImageSizeMb=5
Media__UploadsRoot=wwwroot/uploads
